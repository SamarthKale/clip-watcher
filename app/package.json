{
  "name": "localtube",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "tsx src/server/index.ts",
    "build:ui": "vite build",
    "start": "npm run build:ui && tsx src/server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:ui": "vite build && playwright test",
    "test:all": "vitest run && npm run test:ui",
    "desktop": "npm run build:ui && electron .",
    "icons": "electron scripts/make-icons.cjs",
    "build:server": "vite build -c vite.server.config.ts",
    "build:electron": "vite build -c vite.electron.config.ts",
    "dist": "npm run build:ui && npm run build:server && npm run build:electron && python scripts/stage_resources.py && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "better-sqlite3": "^12.0.0",
    "fastify": "^5.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "motion": "^12.43.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "main": "electron/main.cjs",
  "description": "Spikecut: records a stream, catches the moments chat explodes, edits them into Shorts with Claude, and publishes after your review.",
  "productName": "Spikecut",
  "build": {
    "appId": "app.spikecut.desktop",
    "productName": "Spikecut",
    "directories": {
      "buildResources": "build",
      "output": "out"
    },
    "files": [
      "dist/ui/**",
      "dist/server/**",
      "dist/electron/**",
      "build/icon.*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist/electron/main.cjs"
    },
    "asarUnpack": [
      "dist/ui/**",
      "dist/server/**",
      "node_modules/**"
    ],
    "extraResources": [
      {
        "from": "release-res",
        "to": "."
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Spikecut",
      "artifactName": "Spikecut-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "npmRebuild": false
  }
}
